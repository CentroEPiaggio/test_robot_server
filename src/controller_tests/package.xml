<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>controller_tests</name>
  <version>0.1.0</version>
  <description>
    Test harness for the MACT controllers: a joint-space Lissajous trajectory
    generator and the launch files that run the same experiment against either
    controller, in Gazebo or on the real robot, while recording a bag.
  </description>
  <maintainer email="giorgio.simonini@phd.unipi.it">Giorgio Simonini</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>mact_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>franka_server</exec_depend>
  <exec_depend>mact_controllers</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
